# 학습심리브레인센터 관리 시스템 — 환경변수 예시
# 실제 값은 .env.local(로컬)이나 Vercel 프로젝트 설정(운영)에만 넣고, 이 파일에는 절대 채우지 마세요.
# 이 파일 자체는 저장소에 커밋되어도 안전합니다(값이 없으니까요).

# ---- Supabase (필수) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- 관리자 로그인 (필수) ----
# 관리자 공용 비밀번호. 선생님 계정(전화번호+비밀번호)은 /admin/staff 화면에서 별도로 만듭니다.
ADMIN_PASSWORD=
# 세션 쿠키 서명용 비밀키. 무작위 긴 문자열로 설정하세요(예: openssl rand -hex 32).
SESSION_SECRET=

# ---- AI 기능 (선택 — 없으면 수업기록 AI초안/뇌기능검사 AI해석/이미지 인식이
# 전부 "AI 기능이 아직 설정되지 않았습니다" 안내로 자동 대체되고, 앱은 정상 동작합니다) ----
ANTHROPIC_API_KEY=
# 생략 시 기본값(claude-sonnet-5) 사용
AI_MODEL=
